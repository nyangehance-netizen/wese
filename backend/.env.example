# Copy to .env and change these before going live.
PORT=4000
NODE_ENV=production
# Long random text. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
DB_FILE=./data/wese.db
CORS_ORIGIN=*

# Admin account (created on first start)
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=change-me-too

# Payments: "test" moves no money. Set to your provider once its adapter is written.
PAYMENT_PROVIDER=test
TEST_AUTO_APPROVE_MS=5000
PAYMENT_WEBHOOK_SECRET=

# Pricing (TZS)
SERVICE_FEE_RATE=0.02
RIDER_SHARE=0.8
MAX_DELIVERY_KM=20
BODA_BASE_FEE=3000
BODA_PER_KM=500
TANKER_BASE_FEE=15000
TANKER_PER_KM=1500

# EWURA cap prices per litre for your zone (Dar es Salaam, September 2026 notice PPR/2026-09/01).
# Update monthly when EWURA publishes new caps. 0 = no check.
PRICE_CAP_PETROL=3796
PRICE_CAP_DIESEL=3877
